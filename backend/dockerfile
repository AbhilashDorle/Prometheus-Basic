# Build the Go executable
FROM golang:1.27.2 AS build

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /server .

# Package only the executable
FROM scratch

COPY --from=build /server /server

USER 65532:65532

EXPOSE 3001

ENTRYPOINT ["/server"]